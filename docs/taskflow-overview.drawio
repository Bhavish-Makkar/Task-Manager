<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net"><diagram id="taskflow-overview" name="TaskFlow Overview"><mxGraphModel dx="1200" dy="1000" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1200" pageHeight="1000"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="heading0" value="TaskFlow | Architecture &amp; access overview" style="text;html=0;align=left;fontSize=28;fontStyle=1;fontColor=#172033;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1120" height="40" as="geometry"/></mxCell><mxCell id="heading1" value="01   DATA MODEL" style="text;html=0;align=left;fontSize=15;fontStyle=1;fontColor=#172033;" vertex="1" parent="1"><mxGeometry x="40" y="82" width="1120" height="40" as="geometry"/></mxCell><mxCell id="heading2" value="02   PROJECT MEMBERSHIP &amp; PERMISSIONS" style="text;html=0;align=left;fontSize=15;fontStyle=1;fontColor=#172033;" vertex="1" parent="1"><mxGeometry x="40" y="425" width="1120" height="40" as="geometry"/></mxCell><mxCell id="heading3" value="03   DASHBOARD &amp; DATABASE QUERIES" style="text;html=0;align=left;fontSize=15;fontStyle=1;fontColor=#172033;" vertex="1" parent="1"><mxGeometry x="40" y="680" width="1120" height="40" as="geometry"/></mxCell><mxCell id="user" value="Django User&#xa;&#xa;Built-in authentication&#xa;id / username / email&#xa;Register → Login → Session&#xa;POST logout&#xa;Admin: separate staff interface" style="rounded=1;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=16;fontSize=14;fontColor=#172033;fillColor=#eef2ff;strokeColor=#cbd5e1;" vertex="1" parent="1"><mxGeometry x="40" y="150" width="235" height="200" as="geometry"/></mxCell><mxCell id="project" value="Project&#xa;&#xa;id · name · description&#xa;owner → User (required)&#xa;One owner, many projects&#xa;Owner set by server" style="rounded=1;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=16;fontSize=14;fontColor=#172033;fillColor=#eef2ff;strokeColor=#cbd5e1;" vertex="1" parent="1"><mxGeometry x="335" y="150" width="235" height="200" as="geometry"/></mxCell><mxCell id="task" value="Task&#xa;&#xa;id · title · due_date&#xa;project → Project (required)&#xa;assigned_to → User (nullable)&#xa;To Do / In Progress / Done&#xa;Low / Medium / High" style="rounded=1;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=16;fontSize=14;fontColor=#172033;fillColor=#eef2ff;strokeColor=#cbd5e1;" vertex="1" parent="1"><mxGeometry x="630" y="150" width="235" height="200" as="geometry"/></mxCell><mxCell id="comment" value="Comment&#xa;&#xa;id · body · timestamp (auto)&#xa;task → Task (required)&#xa;author → User (required)&#xa;Append-only in normal app&#xa;Author and task set by server" style="rounded=1;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=16;fontSize=14;fontColor=#172033;fillColor=#eef2ff;strokeColor=#cbd5e1;" vertex="1" parent="1"><mxGeometry x="925" y="150" width="235" height="200" as="geometry"/></mxCell><mxCell id="owner" value="Project owner&#xa;&#xa;View project and all its tasks&#xa;Create / edit / delete tasks&#xa;Edit / delete project&#xa;Read and add comments" style="rounded=1;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=16;fontSize=14;fontColor=#172033;fillColor=#ecfdf5;strokeColor=#cbd5e1;" vertex="1" parent="1"><mxGeometry x="40" y="490" width="350" height="160" as="geometry"/></mxCell><mxCell id="member" value="Assigned project member&#xa;&#xa;Assigned at least one task in project&#xa;View ALL tasks; read / add comments&#xa;No project or task management&#xa;Last assignment removed → access lost" style="rounded=1;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=16;fontSize=14;fontColor=#172033;fillColor=#eff6ff;strokeColor=#cbd5e1;" vertex="1" parent="1"><mxGeometry x="425" y="490" width="350" height="160" as="geometry"/></mxCell><mxCell id="denied" value="Access enforcement&#xa;&#xa;Unrelated user → access denied&#xa;Anonymous user → login required&#xa;Nested task URL checks project + task&#xa;GET/POST checks run on the server" style="rounded=1;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=16;fontSize=14;fontColor=#172033;fillColor=#fff7ed;strokeColor=#cbd5e1;" vertex="1" parent="1"><mxGeometry x="810" y="490" width="350" height="160" as="geometry"/></mxCell><mxCell id="dash" value="My Tasks dashboard&#xa;&#xa;assigned_to = request.user&#xa;To Do / In Progress / Done groups&#xa;Due date ordering; other users excluded&#xa;Overdue: due_date &lt; local today&#xa;AND status != DONE&#xa;Ownership alone does not include tasks" style="rounded=1;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=16;fontSize=14;fontColor=#172033;fillColor=#f5f3ff;strokeColor=#cbd5e1;" vertex="1" parent="1"><mxGeometry x="40" y="745" width="350" height="205" as="geometry"/></mxCell><mxCell id="orm" value="MySQL + reusable ORM&#xa;&#xa;TaskQuerySet.overdue()&#xa;Per-project values(status) + Count(id)&#xa;select_related: forward foreign keys&#xa;Prefetch: project → tasks&#xa;Counts computed in the database&#xa;SQL / EXPLAIN evidence: QUERIES.md" style="rounded=1;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=16;fontSize=14;fontColor=#172033;fillColor=#f5f3ff;strokeColor=#cbd5e1;" vertex="1" parent="1"><mxGeometry x="425" y="745" width="350" height="205" as="geometry"/></mxCell><mxCell id="index" value="One deliberate index&#xa;&#xa;(assigned_to, due_date, status)&#xa;Targets user-scoped overdue query&#xa;Defined in migration 0002&#xa;Automatic PK/FK indexes also exist&#xa;Observed plan used existing FK index&#xa;Measured speedup not established" style="rounded=1;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=16;fontSize=14;fontColor=#172033;fillColor=#f5f3ff;strokeColor=#cbd5e1;" vertex="1" parent="1"><mxGeometry x="810" y="745" width="350" height="205" as="geometry"/></mxCell><mxCell id="edge0" value="1 : many" style="edgeStyle=orthogonalEdgeStyle;html=0;endArrow=block;strokeColor=#64748b;fontSize=11;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="user" target="project"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge1" value="1 : many" style="edgeStyle=orthogonalEdgeStyle;html=0;endArrow=block;strokeColor=#64748b;fontSize=11;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="project" target="task"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge2" value="1 : many" style="edgeStyle=orthogonalEdgeStyle;html=0;endArrow=block;strokeColor=#64748b;fontSize=11;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="task" target="comment"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="note" value="Deletion: Project → Tasks → Comments CASCADE. Assignee deleted → SET_NULL. Author deleted → Comments CASCADE." style="text;html=0;align=left;fontSize=13;fontColor=#475569;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="375" width="1120" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
